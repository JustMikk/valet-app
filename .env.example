# Copy to .env.local.
# Demo API (server build only: `pnpm dev`, `pnpm build:server`). The static export needs none of these.
# Postgres connection string (Neon pooled endpoint).
DATABASE_URL=
# Random 32+ byte hex string used to sign session tokens: node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=
# Optional: put the demo's The Grand Hotel at your coordinates so real GPS can clock in there.
DEMO_VENUE_LAT=
DEMO_VENUE_LNG=
# Web Push keys: npx web-push generate-vapid-keys. Without them the apps run with push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dispatch@example.com
# Optional: secret for the scheduled punch-photo retention job (GET /api/cron/retention).
CRON_SECRET=
