{
  "name": "valet-workforce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "pnpm dlx serve@14 out",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm check:full",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "guard": "node scripts/floor-guard.mjs",
    "secrets": "node scripts/secrets.mjs",
    "secrets:history": "gitleaks git --redact --no-banner",
    "boundaries": "depcruise --validate .dependency-cruiser.cjs src",
    "coverage:changed": "node scripts/changed-coverage.mjs --min 80",
    "deps:scan": "osv-scanner scan source --lockfile pnpm-lock.yaml --config osv-scanner.toml",
    "size": "size-limit",
    "perf": "node scripts/lighthouse.mjs",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm secrets && pnpm guard --warn-bar-change",
    "check:task": "pnpm check:fast && pnpm test:coverage && pnpm coverage:changed && pnpm boundaries",
    "check:full": "pnpm check:task && pnpm format:check && pnpm build && pnpm perf && pnpm size && pnpm deps:scan && pnpm secrets:history && pnpm test:e2e",
    "icons:build": "node scripts/build-icon-font.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
